DATABASE_URL=postgresql://sarveda:password@localhost:5432/sarveda_db
# BullMQ payment-timeout jobs (15 min cancel) + checkout Idempotency-Key cache. Optional locally if you skip the worker.
REDIS_URL=redis://localhost:6379
# Single shared secret (min 32 chars). Backend signs cookies with this; Next.js admin middleware verifies with the SAME value — copy backend JWT_SECRET into frontend/.env.local (see frontend/.env.example).
JWT_SECRET=min-32-chars-secret
JWT_EXPIRES_IN=7d
# Optional (backend only, e.g. EC2). Comma-separated emails still CUSTOMER in DB get ADMIN on next password / Google / OTP login.
# ADMIN_BOOTSTRAP_EMAILS=admin@sarveda.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Staging (Vercel custom domain proxies /api to EC2): https://sarveda-demo.xyz/api/auth/google/callback
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from Razorpay Dashboard (required in production)
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=sarveda-media
AWS_CLOUDFRONT_URL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@sarveda.com
# Order emails (confirmed, shipped, delivered, failed, refund) — requires SENDGRID_API_KEY
ENABLE_COD_CHECKOUT=1
DELHIVERY_WEBHOOK_SECRET=
SENTRY_DSN=
WATI_API_KEY=
WATI_BASE_URL=https://live-mt-server.wati.io
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Must match a pickup location name in Shiprocket (Settings → Pickup locations). Default Primary.
# SHIPROCKET_PICKUP_LOCATION=Primary
# 6-digit warehouse / pickup pin: Shiprocket domestic quotes + checkout PIN serviceability (must match pickup region).
SHIPPING_ORIGIN_PINCODE=560001
# Production default: stub Bluedart/DTDC labels OFF. Set SHIPPING_DISABLE_STUBS=0 only for legacy/testing.
# SHIPPING_DISABLE_STUBS=0
# Production default when Shiprocket creds exist: block checkout if no courier serves origin→delivery PIN. Set to 0 to skip (e.g. local).
# INDIA_REQUIRE_SHIPROCKET_SERVICEABILITY=0
# Backend: create-order rejects non-IN country. Use with frontend NEXT_PUBLIC_INDIA_CHECKOUT_ONLY=1 for India-only launch.
# INDIA_CHECKOUT_ONLY=1
# Shiprocket webhook (use URL without "shiprocket" in path — Shiprocket UI rejects it):
# https://<your-domain>/api/shipping/carrier-events/webhook
# Auth Token Type in Shiprocket: x-api-key  →  set SHIPROCKET_WEBHOOK_HEADER=x-api-key
# Token: same long random string as SHIPROCKET_WEBHOOK_SECRET
# SHIPROCKET_WEBHOOK_HEADER=x-api-key
# SHIPROCKET_WEBHOOK_SECRET=your-long-random-shared-secret
DELHIVERY_API_KEY=
# Staging: https://staging-express.delhivery.com — production: https://track.delhivery.com (no path)
DELHIVERY_BASE_URL=https://staging-express.delhivery.com
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Staging primary origin (comma-separated for multiple): https://sarveda-demo.xyz
# Optional extra browser origins: CORS_ORIGINS=https://sarveda-frontend.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
SENTRY_DSN=
