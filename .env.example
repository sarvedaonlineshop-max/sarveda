DATABASE_URL=postgresql://sarveda:password@localhost:5432/sarveda_db
# Number of DB connections in Prisma pool (default 20).
# Increase for high-traffic or decrease for small instances.
DATABASE_POOL_SIZE=20
# BullMQ payment-timeout jobs (15 min cancel) + checkout Idempotency-Key cache. Optional locally if you skip the worker.
REDIS_URL=redis://localhost:6379
# Single shared secret (min 32 chars). Backend signs cookies with this; Next.js admin middleware verifies with the SAME value — copy backend JWT_SECRET into frontend/.env.local (see frontend/.env.example).
JWT_SECRET=min-32-chars-secret
JWT_EXPIRES_IN=7d
# Optional (backend only, e.g. EC2). Comma-separated emails still CUSTOMER in DB get ADMIN on next password / Google / OTP login.
# Comma-separated emails promoted to ADMIN on login (backend only — set on EC2)
ADMIN_BOOTSTRAP_EMAILS=partha@sarveda.com,arjun@sarveda.com,deepak@sarveda.com,chethan@sarveda.com,shiva@sarveda.com,riya@sarveda.com,prakash@sarveda.com,santhosh@sarveda.com
# Forced SUPER_ADMIN on login (activity audit page). Default includes partha@sarveda.com if unset.
SUPER_ADMIN_EMAILS=partha@sarveda.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Staging (Vercel custom domain proxies /api to EC2): https://sarveda-demo.xyz/api/auth/google/callback
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from Razorpay Dashboard (required in production)
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# PayPal Developer → Webhooks → Webhook ID (for POST /api/payments/paypal/webhook)
PAYPAL_WEBHOOK_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# Must match the region where the S3 bucket was created (Console → bucket → Properties).
# sarveda-media in us-east-1 → set AWS_S3_REGION=us-east-1
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET_NAME=sarveda-media
AWS_CLOUDFRONT_URL=
# Private bucket for internal complaint attachments (not public product CDN)
AWS_S3_COMPLAINTS_BUCKET_NAME=sarveda-complaints
AWS_COMPLAINTS_CLOUDFRONT_URL=
# After migrate:media — same base on Vercel (e.g. https://dxxx.cloudfront.net)
NEXT_PUBLIC_MEDIA_CDN_URL=
CORPORATE_CONTACT_EMAIL=care@sarveda.com
SUPPORT_CONTACT_EMAIL=care@sarveda.com
ENQUIRY_CONTACT_EMAIL=care@sarveda.com
# Zoho ZeptoMail (preferred transactional email) — SMTP
# Dashboard: Mail Agent → SMTP → copy send-mail token as password
ZEPTOMAIL_SMTP_HOST=smtp.zeptomail.com
ZEPTOMAIL_SMTP_PORT=587
ZEPTOMAIL_SMTP_USER=emailapikey
ZEPTOMAIL_SMTP_PASS=
ZEPTOMAIL_FROM_EMAIL=hello@sarveda.com
ZEPTOMAIL_REPLY_TO=care@sarveda.com
# Domain must be verified in ZeptoMail (SPF + DKIM DNS on GoDaddy) before sending.
#
# Legacy Amazon SES SMTP (used only if ZEPTOMAIL_SMTP_PASS is unset)
# Amazon SES SMTP (nodemailer) — ap-south-1 endpoint example below
AWS_SES_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
AWS_SES_SMTP_PORT=587
AWS_SES_SMTP_USER=
AWS_SES_SMTP_PASS=
AWS_SES_FROM_EMAIL=hello@sarveda.com
AWS_SES_REPLY_TO=hello@sarveda.com
# Order emails (confirmed, shipped, delivered, failed, refund, reminders)
# Seller details for GST tax invoice PDF
SELLER_LEGAL_NAME=Sarveda Life Private Limited
SELLER_COMPANY_ID=U85100KA2020PTC141985
SELLER_GSTIN=
SELLER_ADDRESS=No. A2 403, PURVA ATRIA, 1st Block, RMV 2nd Stage, Bengaluru Karnataka 560094
# Return warehouse address on shipping labels (Mysore default)
RETURN_WAREHOUSE_ADDRESS=Plot No. B, Part 2, RASUDHI WAREHOUSE, KIADB Industrial Housing Layout, Hebbal 2nd stage Mysore, Mysore, Karnataka
SELLER_STATE=Karnataka
SELLER_PHONE=9845751678
SELLER_EMAIL=care@sarveda.com
SELLER_WEBSITE=www.sarveda.com
# PNG on S3 — run `cd backend && npm run migrate:brand`; see data/brand-assets.json
SELLER_LOGO_URL=
SELLER_BANK_ACCOUNT_NAME=Sarveda Life Private Limited
SELLER_BANK_ACCOUNT=
SELLER_BANK_NAME=ICICI Bank
SELLER_BANK_IFSC=
SELLER_BANK_ACCOUNT_TYPE=Current
DEFAULT_HSN_CODE=9205
ENABLE_COD_CHECKOUT=1
# Checkout quick-apply coupon chips (comma-separated codes; must exist in Coupon table)
COUPON_CHECKOUT_FEATURED=WELCOME5
# After payment, auto-move order to PROCESSING and create shipping label (Delhivery/Shiprocket)
# AUTO_START_FULFILLMENT_ON_PAID=1
DELHIVERY_WEBHOOK_SECRET=
# Domestic courier default for India labels: delhivery (default) or shiprocket
DEFAULT_DOMESTIC_COURIER=delhivery
# AI shopping chat (/chat) — pick provider or auto (Anthropic wins if both keys set)
# AI_PROVIDER=anthropic
# AI_PROVIDER=openai
ENABLE_AI_CHAT=1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible proxy (Azure, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1
SENTRY_DSN=
# Legacy WATI (unused — WhatsApp is Exotel Cloud API)
WATI_API_KEY=
WATI_BASE_URL=https://live-mt-server.wati.io
# Exotel WhatsApp (order notifications; mirrors notifyOrderEmail events)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# Singapore: api.exotel.com | Mumbai: api.in.exotel.com
EXOTEL_API_HOST=api.exotel.com
# E.164 WhatsApp sender, e.g. +919972238158
EXOTEL_WHATSAPP_FROM=
# Template language code (Meta), usually en
EXOTEL_WHATSAPP_LANG=en
# WhatsApp inbound webhook shared secret — set the same value in the Exotel dashboard URL:
# https://<host>/api/whatsapp/webhook?token=<EXOTEL_WEBHOOK_TOKEN>
EXOTEL_WEBHOOK_TOKEN=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Must match a pickup location name in Shiprocket (Settings → Pickup locations). Default Primary.
# SHIPROCKET_PICKUP_LOCATION=Primary
# 6-digit warehouse / pickup pin: Shiprocket domestic quotes + checkout PIN serviceability (must match pickup region).
SHIPPING_ORIGIN_PINCODE=560001
# Production default: stub Bluedart/DTDC labels OFF. Set SHIPPING_DISABLE_STUBS=0 only for legacy/testing.
# SHIPPING_DISABLE_STUBS=0
# Production default when Shiprocket creds exist: block checkout if no courier serves origin→delivery PIN. Set to 0 to skip (e.g. local).
# INDIA_REQUIRE_SHIPROCKET_SERVICEABILITY=0
# Backend: create-order rejects non-IN country. Use with frontend NEXT_PUBLIC_INDIA_CHECKOUT_ONLY=1 for India-only launch.
# INDIA_CHECKOUT_ONLY=1
# Shiprocket webhook (use URL without "shiprocket" in path — Shiprocket UI rejects it):
# https://<your-domain>/api/shipping/carrier-events/webhook
# Auth Token Type in Shiprocket: x-api-key  →  set SHIPROCKET_WEBHOOK_HEADER=x-api-key
# Token: same long random string as SHIPROCKET_WEBHOOK_SECRET
# SHIPROCKET_WEBHOOK_HEADER=x-api-key
# SHIPROCKET_WEBHOOK_SECRET=your-long-random-shared-secret
DELHIVERY_API_KEY=
# Staging: https://staging-express.delhivery.com — production: https://track.delhivery.com (no path)
DELHIVERY_BASE_URL=https://staging-express.delhivery.com
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Staging primary origin (comma-separated for multiple): https://sarveda-demo.xyz
# Optional extra browser origins: CORS_ORIGINS=https://sarveda-frontend.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:5000
# Vercel server components: hit EC2 directly (faster than self-proxy via sarveda-demo.xyz)
# Staging API host (Lightsail nginx). Override with BACKEND_PROXY_URL on Vercel.
INTERNAL_API_URL=http://13.204.112.165
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
SENTRY_DSN=
