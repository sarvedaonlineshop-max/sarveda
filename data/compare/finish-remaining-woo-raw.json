  "gab": {
    "id": 49832,
    "name": "Singing Bowl Head Set \u2013 G, A, B",
    "slug": "singing-bowl-set-g-a-b",
    "description": "<p>Bring home the timeless tradition of sound healing with this beautifully tuned GAB Singing Bowl Set\u2014crafted to elevate your meditation and create a deeply peaceful atmosphere.</p>",
    "short_description": "<p data-start=\"148\" data-end=\"394\">Experience the soothing harmony of sound with our handcrafted Singing Bowl Set tuned to <strong data-start=\"236\" data-end=\"251\">G, A, and B</strong>. Each bowl is carefully made by skilled artisans, offering rich, resonant tones ideal for meditation, sound healing, and relaxation practices.</p>\n<p data-start=\"396\" data-end=\"526\">This set is perfect for beginners as well as experienced practitioners looking to create a calming and balanced sound environment.</p>\n<h3 data-section-id=\"1dqbs77\" data-start=\"533\" data-end=\"559\">Product Specifications</h3>\n<ul data-start=\"561\" data-end=\"868\">\n<li data-section-id=\"d2mf4e\" data-start=\"561\" data-end=\"634\"><strong data-start=\"563\" data-end=\"578\">B Note Bowl</strong><br data-start=\"578\" data-end=\"581\" />Size: <strong data-start=\"589\" data-end=\"603\">5\u20136 inches</strong><br data-start=\"603\" data-end=\"606\" />Weight: <strong data-start=\"616\" data-end=\"634\">Approx. 0.5 kg</strong></li>\n<li data-section-id=\"tk0e76\" data-start=\"636\" data-end=\"709\"><strong data-start=\"638\" data-end=\"653\">A Note Bowl</strong><br data-start=\"653\" data-end=\"656\" />Size: <strong data-start=\"664\" data-end=\"678\">6\u20137 inches</strong><br data-start=\"678\" data-end=\"681\" />Weight: <strong data-start=\"691\" data-end=\"709\">Approx. 0.8 kg</strong></li>\n<li data-section-id=\"1kmiy3h\" data-start=\"711\" data-end=\"782\"><strong data-start=\"713\" data-end=\"728\">G Note Bowl</strong><br data-start=\"728\" data-end=\"731\" />Size: <strong data-start=\"739\" data-end=\"753\">7\u20138 inches</strong><br data-start=\"753\" data-end=\"756\" />Weight: <strong data-start=\"766\" data-end=\"782\">Approx. 1 kg</strong></li>\n<li data-section-id=\"1x1qg9l\" data-start=\"784\" data-end=\"807\"><strong data-start=\"786\" data-end=\"797\">Tuning:</strong> G, A, B</li>\n<li data-section-id=\"1umwoja\" data-start=\"808\" data-end=\"868\"><strong data-start=\"810\" data-end=\"823\">Material:</strong> Traditional metal alloy (handcrafted finish)</li>\n</ul>",
