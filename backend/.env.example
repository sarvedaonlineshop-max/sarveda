# Complaint / bug-report media (private S3 bucket — separate from sarveda-media)
# Create bucket in AWS Console (block public access), then set on EC2 backend/.env
AWS_S3_COMPLAINTS_BUCKET_NAME=sarveda-complaints
AWS_COMPLAINTS_CLOUDFRONT_URL=

# Firebase Cloud Messaging (required for task push notifications)
# Firebase Console → sarvedataskmanager → Project Settings → Service accounts
# → Generate new private key → copy values into .env below
FIREBASE_PROJECT_ID=sarvedataskmanager
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@sarvedataskmanager.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Zoho Books / Inventory (stock sync, invoices on paid orders)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_BOOKS_BASE_URL=https://www.zohoapis.in/books/v3
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

# Amazon Selling Partner API (India) — optional until marketplace Amazon sync is used
# Seller Central → Apps & Services → Develop Apps → create private app → Authorize → copy LWA values
# Roles needed at minimum: Orders (and Inventory later). Never commit real secrets.
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
# Defaults: Amazon.in marketplace + EU SP-API host
AMAZON_SP_MARKETPLACE_ID=A21TJRUUN4KGV
AMAZON_SP_REGION=eu
# AMAZON_SP_TOKEN_URL=https://api.amazon.com/auth/o2/token
# Optional automatic refresh intervals for Sarveda marketplace hub
AMAZON_SYNC_ORDERS_EVERY_MINUTES=15
AMAZON_SYNC_CATALOG_EVERY_MINUTES=180

# Flipkart Seller API — Self Access credentials from Seller Hub → Developer Access
FLIPKART_API_KEY=
FLIPKART_API_SECRET=
FLIPKART_SYNC_EVERY_MINUTES=30

# Etsy Open API v3 — seller app / own shop
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
ETSY_SYNC_EVERY_MINUTES=30

# Required for refunds + admin "Sarveda → Zoho" stock pushes (inventory adjustments).
# Zoho Books → Settings → Chart of Accounts → open account → copy account_id from URL or API.
# Use "Inventory Adjustment" or "Cost of Goods Sold" style account.
# Set to 1 only if you need legacy bidirectional Zoho stock sync (default off — Sarveda is stock master).
# Purchases module (PO, vendors, bills, expenses) — off until tested
PURCHASES_MODULE_ENABLED=0
ZOHO_INVENTORY_SYNC=0

# Native accounting module — off until reviewed; commerce unaffected when 0
NATIVE_ACCOUNTING_ENABLED=0
ACCOUNTING_SALES_POSTING_ENABLED=0
ACCOUNTING_REFUND_POSTING_ENABLED=0
ACCOUNTING_SETTLEMENT_POSTING_ENABLED=0
ACCOUNTING_PURCHASES_POSTING_ENABLED=0
ACCOUNTING_VENDOR_PAYMENT_POSTING_ENABLED=0
ACCOUNTING_EXPENSE_POSTING_ENABLED=0
ACCOUNTING_INVENTORY_VALUATION_ENABLED=0
# Phase 3D2 — purchase receipt capitalization (1210 → 1200). Requires INVENTORY_VALUATION.
ACCOUNTING_PURCHASE_CAPITALIZATION_ENABLED=0
# Phase 3D3 — FIFO COGS from native layers (5000 / 1200). Requires INVENTORY_VALUATION.
ACCOUNTING_COGS_POSTING_ENABLED=0
# Phase 3D4 — COGS reversal for SELLABLE restocks (1200 / 5000). Requires COGS_POSTING.
ACCOUNTING_COGS_REVERSAL_ENABLED=0
# Phase 4B — bank registry + transfers (default OFF)
ACCOUNTING_BANKING_ENABLED=0
# Phase 4C bank statement import + matching (requires ACCOUNTING_BANKING_ENABLED=1)
ACCOUNTING_BANK_STATEMENT_IMPORT_ENABLED=0
# Phase 4D bank reconciliation + charge/interest categorization (requires statement import)
ACCOUNTING_BANK_RECONCILIATION_ENABLED=0
# COD remittance posting — intentionally unsupported / always OFF in Phase 4D
ACCOUNTING_COD_COLLECTION_ENABLED=0
# Phase 5B — GST ledger + tax snapshot diagnostics (default OFF)
ACCOUNTING_GST_ENABLED=0
# Phase 5B — GST source↔journal reconciliation (requires ACCOUNTING_GST_ENABLED=1)
ACCOUNTING_GST_RECONCILIATION_ENABLED=0
# Phase 5C — ITC evidence / claimability workflow (requires ACCOUNTING_GST_ENABLED=1)
ACCOUNTING_ITC_VERIFICATION_ENABLED=0
# Phase 5D — GSTR-style management reports / XLSX export (requires ACCOUNTING_GST_ENABLED=1)
ACCOUNTING_GST_REPORTING_ENABLED=0
ACCOUNTING_REPORTS_ENABLED=0
# Phase 7B — production opening balance staging/posting (default OFF)
ACCOUNTING_OPENING_BALANCE_ENABLED=0
# Financial year start month (1–12). Default 4 = April (India FY). Used by Phase 6 reports.
# ACCOUNTING_FY_START_MONTH=4
# Accounting cutover — documents strictly before this instant are PRE_CUTOVER.
# For production 01/09/2026 00:00 IST use the offset form (NOT bare YYYY-MM-DD — that parses as UTC midnight = 05:30 IST).
# ACCOUNTING_CUTOVER_DATE=2026-09-01T00:00:00+05:30
# Block shadow posting for pre-cutover documents when forward-only is enabled
# ACCOUNTING_CUTOVER_FORWARD_ONLY=1
# Staging/dev: module posting flags alone can persist. Production-like (incl. Lightsail DB host)
# ALSO requires ACCOUNTING_PRODUCTION_POSTING_ALLOWED=1 — keep 0/absent for Aug UAT so
# real commerce cannot production-post; Phase 7D flips this after owner approval.
# ACCOUNTING_PRODUCTION_POSTING_ALLOWED=0
# Bulk discovery on production-like ALSO requires:
# ACCOUNTING_BULK_DISCOVERY_ALLOWED=0
#
# --- Pre-production UAT profile (Lightsail staging, Aug 26–31) ---
# NATIVE_ACCOUNTING_ENABLED=1
# PURCHASES_MODULE_ENABLED=1
# ACCOUNTING_SALES_POSTING_ENABLED=1
# ACCOUNTING_REFUND_POSTING_ENABLED=1
# ACCOUNTING_SETTLEMENT_POSTING_ENABLED=1
# ACCOUNTING_PURCHASES_POSTING_ENABLED=1
# ACCOUNTING_VENDOR_PAYMENT_POSTING_ENABLED=1
# ACCOUNTING_EXPENSE_POSTING_ENABLED=1
# ACCOUNTING_INVENTORY_VALUATION_ENABLED=1
# ACCOUNTING_PURCHASE_CAPITALIZATION_ENABLED=1
# ACCOUNTING_COGS_POSTING_ENABLED=1
# ACCOUNTING_COGS_REVERSAL_ENABLED=1
# ACCOUNTING_BANKING_ENABLED=1
# ACCOUNTING_BANK_STATEMENT_IMPORT_ENABLED=1
# ACCOUNTING_BANK_RECONCILIATION_ENABLED=1
# ACCOUNTING_GST_ENABLED=1
# ACCOUNTING_GST_RECONCILIATION_ENABLED=1
# ACCOUNTING_ITC_VERIFICATION_ENABLED=1
# ACCOUNTING_GST_REPORTING_ENABLED=1
# ACCOUNTING_REPORTS_ENABLED=1
# ACCOUNTING_OPENING_BALANCE_ENABLED=0
# ACCOUNTING_CUTOVER_DATE=2026-09-01T00:00:00+05:30
# ACCOUNTING_CUTOVER_FORWARD_ONLY=1
# ACCOUNTING_PRODUCTION_POSTING_ALLOWED=0
# ACCOUNTING_BULK_DISCOVERY_ALLOWED=0

# GST tax id for Zoho invoice line items (optional)
ZOHO_SALES_TAX_ID=
