{
  "name": "sarveda-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "stock:replenish": "tsx prisma/replenish-inventory.ts",
    "import:courses": "tsx scripts/import-courses-wxr.ts",
    "import:events": "tsx scripts/import-events-wxr.ts",
    "import:pages": "tsx scripts/import-pages-wxr.ts",
    "import:vaidya": "tsx scripts/import-vaidya-wxr.ts",
    "import:mentors": "tsx scripts/import-mentors-wxr.ts",
    "seed:mentors-from-courses": "tsx scripts/seed-mentors-from-courses.ts",
    "merge:duplicate-mentors": "tsx scripts/merge-duplicate-mentors.ts",
    "import:retreats": "tsx scripts/import-retreats-wxr.ts",
    "import:testimonials": "tsx scripts/import-testimonials-wxr.ts",
    "import:offers": "tsx scripts/import-offers-wxr.ts",
    "import:posts": "tsx scripts/import-posts-wxr.ts",
    "seed:corporate": "tsx scripts/seed-corporate-wellness.ts",
    "import:content": "npm run import:courses && npm run import:events && npm run import:pages",
    "import:all": "npm run import:content && npm run import:vaidya && npm run import:mentors && npm run import:retreats && npm run import:testimonials && npm run import:offers && npm run import:posts",
    "import:coupons": "tsx scripts/import-coupons-wxr.ts",
    "import:variations": "tsx scripts/import-variant-attributes.ts",
    "import:variations:dry": "tsx scripts/import-variant-attributes.ts --dry-run",
    "sync:galleries": "tsx scripts/sync-product-galleries.ts",
    "sync:galleries:dry": "tsx scripts/sync-product-galleries.ts --dry-run",
    "sync:audio": "tsx scripts/sync-product-audio.ts",
    "sync:audio:dry": "tsx scripts/sync-product-audio.ts --dry-run",
    "audit:catalog": "python3 ../scripts/audit-catalog-csv.py",
    "import:full": "npm run import:all && npm run import:coupons && npm run seed:corporate",
    "flush:transactional": "tsx scripts/flush-transactional-data.ts",
    "import:users": "tsx scripts/import-users-wc-csv.ts",
    "import:orders": "tsx scripts/import-orders-wxr.ts",
    "import:refunds": "tsx scripts/import-refunds-wxr.ts",
    "import:reviews": "tsx scripts/import-reviews-from-products.ts",
    "migrate:may-30": "tsx scripts/migrate-may-30.ts",
    "verify:migration": "tsx scripts/verify-may-30-migration.ts",
    "backfill:order-reporting": "tsx scripts/backfill-order-reporting-inr.ts",
    "check:s3": "tsx scripts/check-s3-bucket.ts",
    "migrate:media": "tsx scripts/check-s3-bucket.ts && tsx scripts/migrate-media-to-s3.ts",
    "migrate:media:dry": "tsx scripts/migrate-media-to-s3.ts --dry-run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.821.0",
    "@aws-sdk/s3-request-presigner": "^3.821.0",
    "@prisma/client": "^5.16.2",
    "@sendgrid/mail": "^8.1.3",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.8.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "paypal-rest-sdk": "^1.8.1",
    "pdfkit": "^0.15.0",
    "razorpay": "^2.9.4",
    "stripe": "^16.2.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/paypal-rest-sdk": "^1.7.9",
    "@types/pdfkit": "^0.13.4",
    "csv-parse": "^5.5.6",
    "prisma": "^5.16.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
