/// Gateway refunds: providerRefundId is unique when set (partial index via migration SQL).
model Refund {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String                 @db.Uuid
  amountInPaise    Int
  reason           String?
  providerRefundId String?
