/// Manual EBN recording + future GSP-ready — NEVER posts accounting/GST/stock/shipment bookings.
/// EBN must be government-issued externally; Sarveda never generates EBNs locally.
enum EWayBillStatus {
  NOT_REQUIRED
  PENDING
  GENERATED
  CANCELLED
  EXPIRED
}

enum EWayBillSourceDocumentType {
  TAX_INVOICE
  DELIVERY_CHALLAN
}

enum EWayBillGenerationMethod {
  MANUAL
  API
}

enum EWayBillTransportMode {
  ROAD
  RAIL
  AIR
  SHIP
}

model EWayBill {
  id                      String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                 String                     @db.Uuid
  shipmentId              String?                    @db.Uuid
  sourceDocumentType      EWayBillSourceDocumentType
  sourceInvoiceId         String?                    @db.Uuid
  sourceDeliveryChallanId String?                    @db.Uuid
  sourceDocumentNumber    String
  sourceDocumentDate      DateTime
  /// Government-issued E-Way Bill Number — never auto-generated by Sarveda
  ebn                     String?
  ewbDate                 DateTime?
  validUntil              DateTime?
  status                  EWayBillStatus             @default(PENDING)
  transactionType         String?
  subSupplyType           String?
  subSupplyDesc           String?
  buyerGstin              String?
  transporterName         String?
  transporterId           String?
  transportDocNo          String?
  transportDocDate        DateTime?
  transportMode           EWayBillTransportMode?
  vehicleNumber           String?
  vehicleType             String?
  approxDistanceKm        Int?
  notes                   String?                    @db.Text
  generationMethod        EWayBillGenerationMethod   @default(MANUAL)
  /// PORTAL for V1 manual; future GSP name — never store secrets here
  provider                String?
  providerRequestId       String?
  providerResponseJson    Json?
  recordedByUserId        String?                    @db.Uuid
  documentValueInPaise    Int                        @default(0)
  taxableValueInPaise     Int                        @default(0)
  cancelledAt             DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  order                   Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment                Shipment?                  @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  sourceInvoice           Invoice?                   @relation(fields: [sourceInvoiceId], references: [id], onDelete: SetNull)
  sourceDeliveryChallan   DeliveryChallan?           @relation(fields: [sourceDeliveryChallanId], references: [id], onDelete: SetNull)
  items                   EWayBillItem[]

  @@unique([ebn])
  @@index([orderId, createdAt])
  @@index([status])
  @@index([sourceInvoiceId])
  @@index([sourceDeliveryChallanId])
  @@index([shipmentId])
}

