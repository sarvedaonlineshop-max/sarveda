generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                     String                   @unique
  phone                     String?                  @unique
  name                      String?
  passwordHash              String?
  avatarUrl                 String?
  avatarS3Key               String?
  googleId                  String?                  @unique
  wooCommerceId             Int?                     @unique
  role                      Role                     @default(CUSTOMER)
  isVerified                Boolean                  @default(false)
  deletedAt                 DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  orders                    Order[]
  quotations                Quotation[]
  cart                      Cart?
  addresses                 Address[]
  wishlist                  Wishlist[]
  reviews                   Review[]
  enrollments               Enrollment[]
  bookings                  Booking[]
  stockNotifications        StockNotification[]
  passwordResetTokens       PasswordResetToken[]
  enquiryThreads            EnquiryThread[]
  enquiryAdminMessages      EnquiryMessage[]         @relation("EnquiryAdminMessages")
  whatsappAgentSessions     WhatsAppAgentSession[]   @relation("WhatsAppAgentSessionAdmin")
  adminSessions             AdminSession[]
  adminActivities           AdminActivityLog[]       @relation("AdminActivityActor")
  fcmToken                  String?
  emailNotificationsEnabled Boolean                  @default(true)
  pushNotificationsEnabled  Boolean                  @default(true)
  blogComments              BlogComment[]
  accountClosureRequests    AccountClosureRequest[]
  accountClosureApprovals   AccountClosureApproval[]
}

model AccountClosureRequest {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  email     String
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum AccountClosureApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Admin approval queue for account closure requests.
model AccountClosureApproval {
  id         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String                       @db.Uuid
  email      String
  reason     String
  status     AccountClosureApprovalStatus @default(PENDING)
  createdAt  DateTime                     @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  reviewNote String?
  user       User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Admin login/logout audit for the admin header history panel.
model AdminSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  loginAt   DateTime  @default(now())
  logoutAt  DateTime?
  ip        String?
  userAgent String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loginAt(sort: Desc)])
}

/// Super-admin audit trail of admin backend CRUD + auth events.
model AdminActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String   @db.Uuid
  actorEmail  String
  actorName   String?
  action      String
  resource    String
  summary     String
  method      String?
  path        String?
  entityId    String?
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User     @relation("AdminActivityActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([resource, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String  @db.Uuid
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("IN")
  isDefault  Boolean @default(false)
  user       User    @relation(fields: [userId], references: [id])
}

model Product {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                    String              @unique
  name                    String
  description             String?
  shortDescription        String?
  productType             ProductType         @default(SIMPLE)
  status                  ProductStatus       @default(DRAFT)
  catalogHidden           Boolean             @default(false)
  taxClass                String?             @default("standard")
  hsnCode                 String?
  hasAudio                Boolean             @default(false)
  audioUrl                String?
  videoUrl                String?
  expressShippingEnabled  Boolean             @default(true)
  productCouponEnabled    Boolean             @default(false)
  relatedArticleSlugs     String[]            @default([])
  // Ordered attribute slugs for storefront variant pills (e.g. size before type).
  variantAxisOrder        String[]            @default([])
  /// Per-attribute option value order for storefront pills, e.g. { "color": ["Blue","Red"], "size": ["S","M","L"] }.
  variantOptionValueOrder Json                @default("{}")
  seoTitle                String?
  seoDescription          String?
  seoKeyword              String?
  wooCommerceId           Int?                @unique
  // Global catalog order for /shop and unfiltered lists (admin drag-reorder).
  sortOrder               Int                 @default(0)
  deletedAt               DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  variants                ProductVariant[]
  images                  ProductImage[]
  categories              ProductCategory[]
  accordionItems          AccordionItem[]
  reviews                 Review[]
  wishlist                Wishlist[]
  stockNotifications      StockNotification[]
  relationsFrom           ProductRelation[]   @relation("ProductRelationFrom")
  relationsTo             ProductRelation[]   @relation("ProductRelationTo")

  @@index([sortOrder])
}

enum ProductType {
  SIMPLE
  VARIABLE
  DIGITAL
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductVariant {
  id                         String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId                  String                                @db.Uuid
  sku                        String                                @unique
  mrpInPaise                 Int
  saleInPaise                Int
  /// Purchase / landed cost in INR paise (admin XL sheet)
  costInPaise                Int?
  mrpUsdCents                Int?
  saleUsdCents               Int?
  /// UAE Dirham (Dinar on catalog sheet) in fils (1/100 AED)
  mrpAedFils                 Int?
  saleAedFils                Int?
  mrpGbpPence                Int?
  saleGbpPence               Int?
  weightGrams                Int?
  isDefault                  Boolean                               @default(false)
  status                     VariantStatus                         @default(ACTIVE)
  zohoItemId                 String?                               @db.VarChar(64)
  videoUrl                   String?
  audioUrl                   String?
  /// Historical Woo sellable offer ID for Merchant continuity (`gla_<id>`).
  /// Variable products: Woo variation ID. Simple products: Woo product/offer ID
  /// (same integer Woo used as the Merchant item id). NULL for Sarveda-only / unresolved.
  wooCommerceVariationId     Int?                                  @unique
  /// Vendor can fulfil when Sarveda warehouse stock is insufficient (fulfilment policy, not onHand).
  dropShipEnabled            Boolean                               @default(false)
  productRel                 Product                               @relation(fields: [productId], references: [id])
  inventory                  Inventory?
  attributeValues            VariantAttributeValue[]
  shippingRates              VariantShippingRate[]
  images                     ProductImage[]
  inventoryCostLayers        AccountingInventoryCostLayer[]
  inventoryCostConsumptions  AccountingInventoryCostConsumption[]
  inventoryOpeningBatchItems AccountingInventoryOpeningBatchItem[]
  cartItems                  CartItem[]
  orderItems                 OrderItem[]
  marketplaceListings        MarketplaceListing[]
  marketplaceOrderItems      MarketplaceOrderItem[]
  courseCheckout             Course?
  eventCheckout              Event?
  digitalCheckoutOffer       DigitalCheckoutOffer?
  stockNotifications         StockNotification[]
  purchaseOrderLines         PurchaseOrderLine[]
  vendorBillLines            VendorBillLine[]
  merchantCtxOffer           MerchantCtxOffer?
  createdAt                  DateTime                              @default(now())
  updatedAt                  DateTime                              @updatedAt
}

/// Historical CTX / PRODUCTS SOURCE 2 offer registry (883-row accounting).
model MerchantCtxOffer {
  wooOfferId       Int                       @id
  wooParentId      Int?
  ctxProductType   String
  ctxItemGroupId   String?
  ctxTitle         String?
  ctxLegacyLink    String?
  classification   MerchantCtxClassification @default(MANUAL_REVIEW)
  excludeReason    String?
  manualAction     String?
  sarvedaVariantId String?                   @unique @db.Uuid
  notes            String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  sarvedaVariant   ProductVariant?           @relation(fields: [sarvedaVariantId], references: [id], onDelete: SetNull)

  @@index([classification])
}

enum MerchantCtxClassification {
  PUBLISH
  INTENTIONALLY_EXCLUDE
  MANUAL_REVIEW
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

model Inventory {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId         String         @unique @db.Uuid
  onHand            Int            @default(0)
  reserved          Int            @default(0)
  lowStockThreshold Int            @default(5)
  variant           ProductVariant @relation(fields: [variantId], references: [id])
}

enum MarketplaceChannelCode {
  AMAZON
  FLIPKART
  ETSY
  AMALA
  FIRSTCRY
  TATA_1MG
  SARVEDA
}

enum MarketplaceListingStatus {
  ACTIVE
  PAUSED
  DELISTED
}

enum MarketplaceOrderStatus {
  RECEIVED
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum MarketplaceDataSource {
  MANUAL
  CSV_IMPORT
  EMAIL
  API
}

enum MarketplaceReturnStatus {
  REQUESTED
  RECEIVED
  REFUNDED
  REJECTED
}

model MarketplaceChannel {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        MarketplaceChannelCode @unique
  displayName String
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  listings    MarketplaceListing[]
  orders      MarketplaceOrder[]
  eventLogs   MarketplaceEventLog[]
}

model MarketplaceListing {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId    String                   @db.Uuid
  variantId    String                   @db.Uuid
  listingId    String?
  externalSku  String?
  sellerSku    String?
  status       MarketplaceListingStatus @default(ACTIVE)
  isTracked    Boolean                  @default(true)
  notes        String?
  lastSyncedAt DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  channel      MarketplaceChannel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  variant      ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([channelId, variantId])
  @@index([channelId, status])
  @@index([variantId, status])
}

model MarketplaceOrder {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId        String                 @db.Uuid
  externalOrderId  String
  orderDate        DateTime
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  shipToCity       String?
  shipToState      String?
  shipToCountry    String?
  shipToPostalCode String?
  status           MarketplaceOrderStatus @default(RECEIVED)
  source           MarketplaceDataSource  @default(MANUAL)
  rawPayload       Json?
  notes            String?
  dispatchedAt     DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  channel          MarketplaceChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  items            MarketplaceOrderItem[]
  returns          MarketplaceReturn[]

  @@unique([channelId, externalOrderId])
  @@index([channelId, orderDate(sort: Desc)])
  @@index([status, orderDate(sort: Desc)])
}

model MarketplaceOrderItem {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketplaceOrderId  String              @db.Uuid
  variantId           String?             @db.Uuid
  skuSnapshot         String
  productNameSnapshot String?
  quantity            Int                 @default(1)
  unitPriceInPaise    Int?
  lineTotalInPaise    Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  marketplaceOrder    MarketplaceOrder    @relation(fields: [marketplaceOrderId], references: [id], onDelete: Cascade)
  variant             ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returns             MarketplaceReturn[]

  @@index([marketplaceOrderId])
  @@index([variantId])
  @@index([skuSnapshot])
}

model MarketplaceReturn {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketplaceOrderId     String                  @db.Uuid
  marketplaceOrderItemId String?                 @db.Uuid
  quantity               Int                     @default(1)
  reason                 String?
  status                 MarketplaceReturnStatus @default(REQUESTED)
  receivedAt             DateTime?
  refundedAmountInPaise  Int?
  restockedToZoho        Boolean                 @default(false)
  rawPayload             Json?
  notes                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  marketplaceOrder       MarketplaceOrder        @relation(fields: [marketplaceOrderId], references: [id], onDelete: Cascade)
  marketplaceOrderItem   MarketplaceOrderItem?   @relation(fields: [marketplaceOrderItemId], references: [id], onDelete: SetNull)

  @@index([marketplaceOrderId, status])
  @@index([marketplaceOrderItemId])
}

model MarketplaceEventLog {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId   String                @db.Uuid
  eventType   String
  source      MarketplaceDataSource
  dedupeKey   String?
  rawPayload  Json?
  processedAt DateTime?
  createdAt   DateTime              @default(now())
  channel     MarketplaceChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, dedupeKey])
  @@index([channelId, createdAt(sort: Desc)])
  @@index([source, createdAt(sort: Desc)])
}

// ─── Launch cutover archives (pre-go-live orders / marketplace ops) ───────────

enum LegacyOrderSource {
  D2C
  MARKETPLACE
}

/// Unified pre-launch order history (D2C + marketplace, deduped for analytics).
model LegacyOrderArchive {
  id                         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupeKey                  String            @unique
  source                     LegacyOrderSource
  channelCode                String?
  externalOrderId            String?
  orderNumber                String?
  originalOrderId            String?           @db.Uuid
  originalMarketplaceOrderId String?           @db.Uuid
  customerName               String?
  customerEmail              String?
  customerPhone              String?
  billingAddress             Json?
  shippingAddress            Json?
  status                     String
  paymentProvider            String?
  paymentStatus              String?
  currency                   String            @default("INR")
  subtotalInPaise            Int               @default(0)
  discountInPaise            Int               @default(0)
  shippingInPaise            Int               @default(0)
  taxInPaise                 Int               @default(0)
  grandTotalInPaise          Int
  orderDate                  DateTime
  placedAt                   DateTime?
  itemCount                  Int               @default(0)
  linePreview                String[]          @default([])
  items                      Json
  payments                   Json?
  shipments                  Json?
  wooCommerceId              Int?
  zohoInvoiceId              String?
  zohoInvoiceNo              String?
  notes                      String?
  rawSnapshot                Json?
  migratedAt                 DateTime          @default(now())
  createdAt                  DateTime          @default(now())

  @@index([orderDate(sort: Desc)])
  @@index([source, orderDate(sort: Desc)])
  @@index([channelCode, orderDate(sort: Desc)])
  @@index([orderNumber])
  @@index([customerEmail])
  @@index([originalOrderId])
  @@index([originalMarketplaceOrderId])
}

/// Snapshot of pre-launch marketplace orders (live ops table cleared at cutover).
model LegacyMarketplaceOrderArchive {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originalMarketplaceOrderId String    @unique @db.Uuid
  channelId                  String    @db.Uuid
  channelCode                String
  externalOrderId            String
  orderDate                  DateTime
  customerName               String?
  customerEmail              String?
  customerPhone              String?
  shipToCity                 String?
  shipToState                String?
  shipToCountry              String?
  shipToPostalCode           String?
  status                     String
  source                     String
  grandTotalInPaise          Int       @default(0)
  currency                   String    @default("INR")
  items                      Json
  returns                    Json?
  rawPayload                 Json?
  notes                      String?
  dispatchedAt               DateTime?
  deliveredAt                DateTime?
  cancelledAt                DateTime?
  migratedAt                 DateTime  @default(now())
  createdAt                  DateTime  @default(now())

  @@index([channelCode, orderDate(sort: Desc)])
  @@index([orderDate(sort: Desc)])
  @@index([externalOrderId])
}

/// Historical Zoho Books invoices (all channels). Separate from Order / MarketplaceOrder.
/// Append-only upsert by zohoInvoiceId — used for pre-cutover analytics reference.
model ZohoHistoricalInvoice {
  id                       String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zohoInvoiceId            String                      @unique
  invoiceNumber            String
  invoiceDate              DateTime                    @db.Date
  issuedDate               DateTime?                   @db.Date
  dueDate                  DateTime?                   @db.Date
  status                   String
  customerName             String?
  customerIdZoho           String?
  email                    String?
  phone                    String?
  currency                 String                      @default("INR")
  exchangeRate             Float?
  /// Invoice totals in minor units of `currency` (paise/cents/fils/pence).
  subtotalInMinor          Int                         @default(0)
  discountInMinor          Int                         @default(0)
  shippingInMinor          Int                         @default(0)
  taxInMinor               Int                         @default(0)
  totalInMinor             Int                         @default(0)
  balanceInMinor           Int                         @default(0)
  /// FX-normalized INR paise for dashboard totals (reporting helper rates).
  reportingTotalInInrPaise Int                         @default(0)
  salesChannelRaw          String?
  marketplaceRaw           String?
  /// Normalized bucket: Amazon, Flipkart, Web Sales, Offline Sales, etc.
  channelNormalized        String
  ecomOrderId              String?
  ecomInvoiceNo            String?
  salesOrderNumber         String?
  billingCity              String?
  billingState             String?
  billingCountry           String?
  billingPostalCode        String?
  shippingCity             String?
  shippingState            String?
  shippingCountry          String?
  notes                    String?                     @db.Text
  sourceFile               String?
  importedAt               DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  lines                    ZohoHistoricalInvoiceLine[]

  @@index([invoiceDate])
  @@index([channelNormalized, invoiceDate])
  @@index([status, invoiceDate])
  @@index([currency, invoiceDate])
  @@index([invoiceNumber])
}

model ZohoHistoricalInvoiceLine {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId        String                @db.Uuid
  lineIndex        Int                   @default(0)
  itemName         String?
  itemDesc         String?               @db.Text
  sku              String?
  quantity         Float                 @default(0)
  /// Unit / line amounts in minor units of parent invoice currency.
  unitPriceInMinor Int                   @default(0)
  lineTotalInMinor Int                   @default(0)
  discountInMinor  Int                   @default(0)
  taxName          String?
  taxPercent       Float?
  taxAmountInMinor Int                   @default(0)
  hsnSac           String?
  invoice          ZohoHistoricalInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineIndex])
  @@index([sku])
  @@index([invoiceId])
}

model ProductImage {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String          @db.Uuid
  variantId String?         @db.Uuid
  url       String
  altText   String?
  position  Int             @default(0)
  isPrimary Boolean         @default(false)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model AccordionItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @db.Uuid
  title     String
  content   String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])
}

/// Curated PDP pair-with / upsell / cross-sell links (from Woo ACF + _upsell_ids).
model ProductRelation {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromProductId String              @db.Uuid
  toProductId   String              @db.Uuid
  type          ProductRelationType
  position      Int                 @default(0)
  createdAt     DateTime            @default(now())
  fromProduct   Product             @relation("ProductRelationFrom", fields: [fromProductId], references: [id], onDelete: Cascade)
  toProduct     Product             @relation("ProductRelationTo", fields: [toProductId], references: [id], onDelete: Cascade)

  @@unique([fromProductId, toProductId, type])
  @@index([fromProductId, type, position])
}

enum ProductRelationType {
  PAIR_WITH
  UPSELL
  CROSS_SELL
}

model Category {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String            @unique
  name           String
  description    String?
  imageUrl       String?
  parentId       String?           @db.Uuid
  position       Int               @default(0)
  seoTitle       String?
  seoDescription String?
  parent         Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]        @relation("CategoryTree")
  products       ProductCategory[]
}

model ProductCategory {
  productId  String   @db.Uuid
  categoryId String   @db.Uuid
  // Order within this category (admin drag-reorder when category filter is set).
  position   Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
  @@index([categoryId, position])
}

model ProductAttribute {
  id     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String
  slug   String           @unique
  values AttributeValue[]
}

model AttributeValue {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attributeId String                  @db.Uuid
  value       String
  slug        String
  attribute   ProductAttribute        @relation(fields: [attributeId], references: [id])
  variants    VariantAttributeValue[]
}

model VariantAttributeValue {
  variantId        String         @db.Uuid
  attributeValueId String         @db.Uuid
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@id([variantId, attributeValueId])
}

model VariantShippingRate {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId           String         @db.Uuid
  country             String
  standardPerProduct  Int
  standardAdditional  Int            @default(0)
  expeditedPerProduct Int
  expeditedAdditional Int            @default(0)
  codPerProduct       Int?
  codAdditional       Int?
  estimatedDays       String?
  variant             ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([variantId, country])
}

model Cart {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String?    @unique @db.Uuid
  sessionId            String?    @unique
  couponCode           String?
  /// Set when abandoned-cart reminder email was sent (reset on cart mutation).
  abandonedEmailSentAt DateTime?
  user                 User?      @relation(fields: [userId], references: [id])
  items                CartItem[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model CartItem {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId         String               @db.Uuid
  /// Shop product line (mutually exclusive with digitalOfferId).
  variantId      String?              @db.Uuid
  /// Course/event DigitalCheckoutOffer line (mutually exclusive with variantId).
  digitalOfferId String?              @db.Uuid
  quantity       Int                  @default(1)
  cart           Cart                 @relation(fields: [cartId], references: [id])
  variant        ProductVariant?      @relation(fields: [variantId], references: [id])
  digitalOffer   DigitalCheckoutOffer? @relation(fields: [digitalOfferId], references: [id])

  @@unique([cartId, variantId])
  @@unique([cartId, digitalOfferId])
  @@index([digitalOfferId])
}

model Order {
  id                       String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber              String                       @unique
  wooCommerceId            Int?                         @unique
  wooLegacyMeta            Json?
