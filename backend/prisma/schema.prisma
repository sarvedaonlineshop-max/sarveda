model EnquiryThread {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source                EnquirySource
  subjectCategory       EnquirySubjectCategory?
  customSubject         String?
  customerName          String
  customerEmail         String
  customerPhone         String?
  orderNumber           String?
  contextTitle          String?
  contextUrl            String?
