/// Physical return / restock disposition for a sold OrderItem.
/// Accounting Phase 3D4 will post COGS reversal only from SELLABLE events that incremented stock.
/// Financial Refund rows remain separate and must not be used as restock provenance.
enum OrderInventoryRestockDisposition {
  SELLABLE
  DAMAGED
  NON_RESTOCKABLE
}

enum OrderInventoryRestockSourceType {
  /// Full paid-order CANCELLED / REFUNDED via handlePaidOrderStatusChange → restockPaidOrderTx
  FULL_ORDER_STATUS_CHANGE
  /// Admin explicit line-level restock (partial returns, damaged receipt, etc.)
  ADMIN_EXPLICIT
  /// RTO physical receipt disposition (Phase 1C)
  RTO_PHYSICAL_RECEIPT
  /// Pre-dispatch order adjustment (Phase 1D)
  ORDER_ADJUSTMENT
  /// Customer return physical receipt (Phase 2)
  CUSTOMER_RETURN_RECEIPT
}

model OrderInventoryRestockEvent {
  id                   String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId              String                           @db.Uuid
  orderItemId          String                           @db.Uuid
  variantId            String                           @db.Uuid
  quantity             Int
  disposition          OrderInventoryRestockDisposition
  /// True only when this event incremented Inventory.onHand (SELLABLE + inventory row present).
  inventoryIncremented Boolean                          @default(false)
  sourceType           OrderInventoryRestockSourceType
  /// Idempotency scope: e.g. "{orderId}:REFUNDED" or admin batch UUID / Idempotency-Key.
  sourceId             String
  reason               String?
  createdByUserId      String?                          @db.Uuid
  createdAt            DateTime                         @default(now())
  order                Order                            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem            OrderItem                        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId, orderItemId])
  @@index([orderId, createdAt])
  @@index([orderItemId])
  @@index([variantId])
  @@map("order_inventory_restock_events")
}

