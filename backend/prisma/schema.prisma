model AccountingVendorPaymentAllocation {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId     String                  @db.Uuid
  payment       AccountingVendorPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  vendorBillId  String                  @db.Uuid
  amountInPaise Int
  createdAt     DateTime                @default(now())

  @@unique([paymentId, vendorBillId])
  @@index([paymentId])
  @@index([vendorBillId])
}

/// Maps free-text Expense.expenseAccount → EXPENSE-type CoA (Phase 3C2).
model AccountingExpenseAccountMapping {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  normalizedSourceName  String
  displayName           String
  accountingAccountCode String
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([normalizedSourceName])
  @@index([accountingAccountCode])
  @@index([isActive])
}

/// Maps free-text Expense.paidThrough → bank/cash account (Phase 3C2 / 4B).
model AccountingExpensePaymentMapping {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  normalizedSourceName String
  displayName          String
  paidAccountCode      String
  bankAccountId        String?                @db.Uuid
  bankAccount          AccountingBankAccount? @relation(fields: [bankAccountId], references: [id])
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([normalizedSourceName])
  @@index([paidAccountCode])
  @@index([bankAccountId])
  @@index([isActive])
}

// ─── Phase 4B: banking & cash registry + transfers ───────────────────────────

enum AccountingBankAccountType {
  BANK
  CASH
  PETTY_CASH
}

enum AccountingBankTransferKind {
  INTERNAL_TRANSFER
  CASH_DEPOSIT
  CASH_WITHDRAWAL
}

enum AccountingBankTransferStatus {
  DRAFT
  POSTED
  VOID
}

/// Registry linking operational bank/cash identity to a GL ASSET account.
model AccountingBankAccount {
  id                       String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String
  bankName                 String?
  maskedAccountNumber      String?
  ifsc                     String?
  currency                 String                            @default("INR")
  glAccountCode            String                            @unique
  accountType              AccountingBankAccountType
  isActive                 Boolean                           @default(true)
  isDefault                Boolean                           @default(false)
  statementImportEnabled   Boolean                           @default(false)
  razorpaySettlementTarget Boolean                           @default(false)
  createdByUserId          String?                           @db.Uuid
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  vendorPayments           AccountingVendorPayment[]
  expensePaymentMappings   AccountingExpensePaymentMapping[]
  settlementTargets        AccountingGatewaySettlement[]     @relation("SettlementTargetBank")
  sourceTransfers          AccountingBankTransfer[]          @relation("TransferSource")
  destTransfers            AccountingBankTransfer[]          @relation("TransferDest")
  statementImports         AccountingBankStatementImport[]
  statementLines           AccountingBankStatementLine[]
  reconciliations          AccountingBankReconciliation[]

  @@index([accountType])
  @@index([isActive])
  @@index([razorpaySettlementTarget])
}

model AccountingBankTransfer {
  id                       String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transferNumber           String                       @unique
  transferDate             DateTime                     @db.Date
  amountInPaise            Int
  currency                 String                       @default("INR")
  transferKind             AccountingBankTransferKind
  sourceBankAccountId      String                       @db.Uuid
  sourceBankAccount        AccountingBankAccount        @relation("TransferSource", fields: [sourceBankAccountId], references: [id])
  destinationBankAccountId String                       @db.Uuid
  destinationBankAccount   AccountingBankAccount        @relation("TransferDest", fields: [destinationBankAccountId], references: [id])
  reference                String?
  memo                     String?
  status                   AccountingBankTransferStatus @default(DRAFT)
  sourcePayloadHash        String
  postingEventId           String?                      @unique @db.Uuid
  postingEvent             AccountingPostingEvent?      @relation(fields: [postingEventId], references: [id])
  journalEntryId           String?                      @unique @db.Uuid
  journalEntry             AccountingJournalEntry?      @relation(fields: [journalEntryId], references: [id])
  createdByUserId          String?                      @db.Uuid
  lastError                String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  @@index([transferDate])
  @@index([status])
  @@index([sourceBankAccountId])
  @@index([destinationBankAccountId])
}

enum AccountingBankStatementImportStatus {
  IMPORTED
  FAILED
}

enum AccountingBankStatementLineMatchStatus {
  UNMATCHED
  MATCHED_EXACT
  MATCHED_MANUAL
  MATCHED_CATEGORIZED
  POSSIBLE
  DUPLICATE
  REVIEW_REQUIRED
  IGNORED
}

enum AccountingBankStatementMatchConfidence {
  EXACT
  HIGH
  POSSIBLE
}

enum AccountingBankStatementMatchStatus {
  CANDIDATE
  CONFIRMED
  REJECTED
}

enum AccountingBankStatementMatchType {
  RAZORPAY_SETTLEMENT
  VENDOR_PAYMENT
  EXPENSE
  BANK_TRANSFER
  BANK_OPENING
  BANK_CHARGE
  BANK_INTEREST
  JOURNAL_OTHER
}

/// Committed bank statement evidence (Phase 4C). No GL posting from import.
model AccountingBankStatementImport {
  id                    String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankAccountId         String                              @db.Uuid
  bankAccount           AccountingBankAccount               @relation(fields: [bankAccountId], references: [id])
  fileName              String
  fileHash              String
  statementFrom         DateTime?                           @db.Date
  statementTo           DateTime?                           @db.Date
  openingBalanceInPaise Int?
  closingBalanceInPaise Int?
  currency              String                              @default("INR")
  importStatus          AccountingBankStatementImportStatus @default(IMPORTED)
  rowCount              Int                                 @default(0)
  debitTotalInPaise     Int                                 @default(0)
  creditTotalInPaise    Int                                 @default(0)
  failureReason         String?
  importedByUserId      String?                             @db.Uuid
  createdAt             DateTime                            @default(now())
  committedAt           DateTime?
  lines                 AccountingBankStatementLine[]
  reconciliations       AccountingBankReconciliation[]

  @@unique([bankAccountId, fileHash])
  @@index([bankAccountId])
  @@index([importStatus])
  @@index([committedAt])
}

model AccountingBankStatementLine {
  id                     String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  statementImportId      String                                 @db.Uuid
  statementImport        AccountingBankStatementImport          @relation(fields: [statementImportId], references: [id], onDelete: Cascade)
  bankAccountId          String                                 @db.Uuid
  bankAccount            AccountingBankAccount                  @relation(fields: [bankAccountId], references: [id])
  rowNumber              Int
  transactionDate        DateTime                               @db.Date
  valueDate              DateTime?                              @db.Date
  description            String
  reference              String?
  debitInPaise           Int                                    @default(0)
  creditInPaise          Int                                    @default(0)
  runningBalanceInPaise  Int?
  transactionFingerprint String
  matchStatus            AccountingBankStatementLineMatchStatus @default(UNMATCHED)
  category               AccountingBankStatementLineCategory?
  categoryNote           String?
  categorizedAt          DateTime?
  categorizedByUserId    String?                                @db.Uuid
  reconciliationId       String?                                @db.Uuid
  reconciliation         AccountingBankReconciliation?          @relation(fields: [reconciliationId], references: [id])
  createdAt              DateTime                               @default(now())
  matches                AccountingBankStatementMatch[]

  @@unique([bankAccountId, transactionFingerprint])
  @@index([statementImportId])
  @@index([bankAccountId])
  @@index([transactionDate])
  @@index([matchStatus])
  @@index([reference])
  @@index([category])
  @@index([reconciliationId])
}

model AccountingBankStatementMatch {
  id                   String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  statementLineId      String                                 @db.Uuid
  statementLine        AccountingBankStatementLine            @relation(fields: [statementLineId], references: [id], onDelete: Cascade)
  journalEntryId       String                                 @db.Uuid
  journalEntry         AccountingJournalEntry                 @relation(fields: [journalEntryId], references: [id])
  matchType            AccountingBankStatementMatchType
  confidence           AccountingBankStatementMatchConfidence
  status               AccountingBankStatementMatchStatus     @default(CANDIDATE)
  matchedAmountInPaise Int
  bankGlAccountCode    String
  sourceEntityType     String?
  sourceEntityId       String?
  evidenceJson         Json?
  matchedByUserId      String?                                @db.Uuid
  matchedAt            DateTime?
  createdAt            DateTime                               @default(now())

  @@index([statementLineId])
  @@index([journalEntryId])
  @@index([status])
  @@index([confidence])
}

enum AccountingBankStatementLineCategory {
  BANK_CHARGE
  BANK_INTEREST
  IGNORE
  UNKNOWN
  POSSIBLE_DUPLICATE_GATEWAY_FEE
}

enum AccountingBankReconciliationStatus {
  OPEN
  IN_PROGRESS
  RECONCILED
  REOPENED
}

/// Formal per-bank reconciliation period (Phase 4D). Does not post GL by itself.
model AccountingBankReconciliation {
  id                             String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankAccountId                  String                             @db.Uuid
  bankAccount                    AccountingBankAccount              @relation(fields: [bankAccountId], references: [id])
  periodStart                    DateTime                           @db.Date
  periodEnd                      DateTime                           @db.Date
  statementImportId              String?                            @db.Uuid
  statementImport                AccountingBankStatementImport?     @relation(fields: [statementImportId], references: [id])
  statementOpeningBalanceInPaise Int?
  statementClosingBalanceInPaise Int?
  bookOpeningBalanceInPaise      Int                                @default(0)
  bookClosingBalanceInPaise      Int                                @default(0)
  bookDebitTotalInPaise          Int                                @default(0)
  bookCreditTotalInPaise         Int                                @default(0)
  differenceInPaise              Int                                @default(0)
  status                         AccountingBankReconciliationStatus @default(OPEN)
  snapshotJson                   Json?
  reconciledAt                   DateTime?
  reconciledByUserId             String?                            @db.Uuid
  reopenedAt                     DateTime?
  reopenedByUserId               String?                            @db.Uuid
  reopenReason                   String?
  notes                          String?
  createdAt                      DateTime                           @default(now())
  updatedAt                      DateTime                           @updatedAt
  statementLines                 AccountingBankStatementLine[]

  @@unique([bankAccountId, periodStart, periodEnd])
  @@index([bankAccountId])
  @@index([status])
  @@index([periodEnd])
}

// ─── Phase 3D1: accounting-owned inventory cost layers (parallel to ops Inventory) ─

enum AccountingInventoryCostLayerSourceType {
  OPENING
  PURCHASE_RECEIPT
  RETURN_RESTOCK
}

enum AccountingInventoryCostLayerStatus {
  ACTIVE
  DEPLETED
  VOID
}

enum AccountingInventoryOpeningBatchStatus {
  DRAFT
  VALIDATED
  POSTED
  VOID
}

model AccountingInventoryCostLayer {
  id                 String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId          String                                 @db.Uuid
  variant            ProductVariant                         @relation(fields: [variantId], references: [id])
  sourceType         AccountingInventoryCostLayerSourceType
  sourceId           String
  sourceLineId       String?                                @db.Uuid
  quantityOriginal   Int
  quantityRemaining  Int
  unitCostInPaise    Int
  totalCostInPaise   Int
  currency           String                                 @default("INR")
  effectiveAt        DateTime
  sourceFingerprint  String
  status             AccountingInventoryCostLayerStatus     @default(ACTIVE)
  openingBatchItemId String?                                @unique @db.Uuid
  openingBatchItem   AccountingInventoryOpeningBatchItem?   @relation(fields: [openingBatchItemId], references: [id])
  createdAt          DateTime                               @default(now())
  updatedAt          DateTime                               @updatedAt
  consumptions       AccountingInventoryCostConsumption[]

  @@unique([sourceType, sourceId, sourceLineId, sourceFingerprint])
  @@index([variantId, status, effectiveAt, createdAt, id])
  @@index([variantId, quantityRemaining])
  @@index([sourceType, sourceId])
}

model AccountingInventoryCostConsumption {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  costLayerId       String                       @db.Uuid
  costLayer         AccountingInventoryCostLayer @relation(fields: [costLayerId], references: [id])
  variantId         String                       @db.Uuid
  variant           ProductVariant               @relation(fields: [variantId], references: [id])
  orderId           String?                      @db.Uuid
  orderItemId       String?                      @db.Uuid
  quantityConsumed  Int
  unitCostInPaise   Int
  totalCostInPaise  Int
  consumedAt        DateTime
  postingEventId    String?                      @db.Uuid
  journalEntryId    String?                      @db.Uuid
  sourceFingerprint String?
  createdAt         DateTime                     @default(now())

  @@index([costLayerId])
  @@index([variantId])
  @@index([orderId])
  @@index([orderItemId])
}

model AccountingInventoryOpeningBatch {
  id                    String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchNumber           String                                @unique
  effectiveDate         DateTime                              @db.Date
  valuationSource       String
  sourceDocumentRef     String?
  preparedBy            String?
  reviewedBy            String?
  status                AccountingInventoryOpeningBatchStatus @default(DRAFT)
  totalQuantity         Int                                   @default(0)
  totalValueInPaise     Int                                   @default(0)
  sourceFileName        String?
  sourcePayloadHash     String
  allowQuantityMismatch Boolean                               @default(false)
  journalEntryId        String?                               @unique @db.Uuid
  journalEntry          AccountingJournalEntry?               @relation(fields: [journalEntryId], references: [id])
  postingEventId        String?                               @unique @db.Uuid
  createdByUserId       String?                               @db.Uuid
  postedAt              DateTime?
  createdAt             DateTime                              @default(now())
  updatedAt             DateTime                              @updatedAt
  items                 AccountingInventoryOpeningBatchItem[]

  @@index([status])
  @@index([effectiveDate])
}

model AccountingInventoryOpeningBatchItem {
  id                String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId           String                          @db.Uuid
  batch             AccountingInventoryOpeningBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  variantId         String                          @db.Uuid
  variant           ProductVariant                  @relation(fields: [variantId], references: [id])
  sku               String
  openingQuantity   Int
  unitCostInPaise   Int
  totalCostInPaise  Int
  operationalOnHand Int
  quantityMismatch  Boolean                         @default(false)
  classification    String
  notes             String?
  validationErrors  Json?
  costLayerId       String?                         @db.Uuid
  sortOrder         Int                             @default(0)
  createdAt         DateTime                        @default(now())
  costLayer         AccountingInventoryCostLayer?

  @@unique([batchId, variantId])
  @@unique([batchId, sku])
  @@index([batchId])
  @@index([variantId])
}

// ─── Phase 5C — ITC evidence (claimability ≠ GL recognition) ─────────────────

enum AccountingItcStatus {
  UNVERIFIED_PENDING_TAX_INVOICE
  ELIGIBLE
  BLOCKED
  REVERSED
  CLAIMED
  DATA_GAP
}

enum AccountingItcSourceType {
  VENDOR_BILL
  EXPENSE
  GATEWAY_SETTLEMENT
}

/// Accounting-owned ITC evidence / claimability. Does not own commerce records or rewrite GL.
model AccountingItcEvidence {
  id                  String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceType          AccountingItcSourceType
  sourceId            String                       @db.Uuid
  uniqueKey           String                       @unique
  documentReference   String?
  supplierGstin       String?
  supplierName        String?
  documentDate        DateTime?
  taxableValueInPaise Int                          @default(0)
  cgstInPaise         Int                          @default(0)
  sgstInPaise         Int                          @default(0)
  igstInPaise         Int                          @default(0)
  totalGstInPaise     Int                          @default(0)
  /// True when Input GST was posted to 2200–2202. False for gateway fee-tax (5100).
  recognizedInInputGl Boolean                      @default(false)
  postingEventId      String?                      @db.Uuid
  journalEntryId      String?                      @db.Uuid
  status              AccountingItcStatus          @default(UNVERIFIED_PENDING_TAX_INVOICE)
  assessmentCode      String?
  assessmentJson      Json?
  evidenceWarnings    Json?
  verificationNotes   String?
  verifiedAt          DateTime?
  verifiedByUserId    String?                      @db.Uuid
  claimedAt           DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  statusHistory       AccountingItcStatusHistory[]

  @@unique([sourceType, sourceId])
  @@index([status])
  @@index([sourceType])
  @@index([documentDate])
  @@index([supplierGstin])
}

model AccountingItcStatusHistory {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceId  String                @db.Uuid
  evidence    AccountingItcEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  oldStatus   AccountingItcStatus?
  newStatus   AccountingItcStatus
  actorUserId String?               @db.Uuid
  reason      String?
  createdAt   DateTime              @default(now())

  @@index([evidenceId, createdAt])
  @@index([createdAt])
}

// ─── Phase 7B — Production opening batch (cutover infrastructure) ────────────

enum AccountingOpeningBatchStatus {
  DRAFT
  VALIDATED
  POSTED
  CANCELLED
}

enum AccountingOpeningMatchStatus {
  EXACT
  MANUAL_MATCH
  NEW_SKU
  LEGACY_ONLY
  UNKNOWN
}

enum AccountingOpeningReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Single production cutover opening batch. At most one POSTED.
model AccountingOpeningBatch {
  id                 String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchNumber        String                           @unique
  effectiveDate      DateTime                         @db.Date
  status             AccountingOpeningBatchStatus     @default(DRAFT)
  source             String                           @default("MANUAL")
  description        String?
  createdByUserId    String?                          @db.Uuid
  validatedAt        DateTime?
  postedAt           DateTime?
  cancelledAt        DateTime?
  totalDebitInPaise  Int                              @default(0)
  totalCreditInPaise Int                              @default(0)
  validationSummary  Json?
  sourceFingerprint  String?
  arApprovedZero     Boolean                          @default(false)
  equity3900Reason   String?
  equity3900Reviewer String?
  equity3900Approved Boolean                          @default(false)
  journalEntryId     String?                          @unique @db.Uuid
  journalEntry       AccountingJournalEntry?          @relation(fields: [journalEntryId], references: [id])
  postingEventId     String?                          @unique @db.Uuid
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  skuMappings        AccountingOpeningSkuMapping[]
  inventoryLines     AccountingOpeningInventoryLine[]
  bankLines          AccountingOpeningBankLine[]
  gatewayLines       AccountingOpeningGatewayLine[]
  apLines            AccountingOpeningApLine[]
  arLines            AccountingOpeningArLine[]
  gstLines           AccountingOpeningGstLine[]
  equityLines        AccountingOpeningEquityLine[]

  @@index([status])
  @@index([effectiveDate])
}

model AccountingOpeningSkuMapping {
  id              String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId         String                        @db.Uuid
  batch           AccountingOpeningBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  newSarvedaSku   String
  legacySku       String?
  productName     String?
  variantLabel    String?
  matchStatus     AccountingOpeningMatchStatus  @default(UNKNOWN)
  openingQty      Int                           @default(0)
  unitCostInPaise Int                           @default(0)
  source          String?
  reviewStatus    AccountingOpeningReviewStatus @default(PENDING)
  variantId       String?                       @db.Uuid
  notes           String?
  sortOrder       Int                           @default(0)
  createdAt       DateTime                      @default(now())

  @@unique([batchId, newSarvedaSku])
  @@index([batchId])
}

model AccountingOpeningInventoryLine {
  id                String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId           String                        @db.Uuid
  batch             AccountingOpeningBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sku               String
  variantId         String?                       @db.Uuid
  quantity          Int
  unitCostInPaise   Int
  totalCostInPaise  Int
  operationalOnHand Int                           @default(0)
  quantityMismatch  Boolean                       @default(false)
  source            String?
  reviewStatus      AccountingOpeningReviewStatus @default(PENDING)
  costLayerId       String?                       @db.Uuid
  sortOrder         Int                           @default(0)
  createdAt         DateTime                      @default(now())

  @@unique([batchId, sku])
  @@index([batchId])
}

model AccountingOpeningBankLine {
  id                        String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId                   String                        @db.Uuid
  batch                     AccountingOpeningBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  name                      String
  bankName                  String?
  maskedAccountNumber       String?
  ifsc                      String?
  accountType               String                        @default("BANK")
  glAccountCode             String
  openingBookBalanceInPaise Int
  statementBalanceInPaise   Int?
  source                    String?
  reviewStatus              AccountingOpeningReviewStatus @default(PENDING)
  sortOrder                 Int                           @default(0)
  createdAt                 DateTime                      @default(now())

  @@unique([batchId, glAccountCode])
  @@index([batchId])
}

model AccountingOpeningGatewayLine {
  id                     String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId                String                        @db.Uuid
  batch                  AccountingOpeningBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  provider               String
  glAccountCode          String
  unsettledAmountInPaise Int
  /// ASSET = debit clearing; LIABILITY = credit clearing
  direction              String                        @default("ASSET")
  sourceReference        String?
  reviewStatus           AccountingOpeningReviewStatus @default(PENDING)
  sortOrder              Int                           @default(0)
  createdAt              DateTime                      @default(now())

  @@unique([batchId, provider])
  @@index([batchId])
}

model AccountingOpeningApLine {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId                     String                        @db.Uuid
  batch                       AccountingOpeningBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  vendorName                  String
  vendorId                    String?                       @db.Uuid
  billNumber                  String
  billDate                    DateTime?                     @db.Date
  dueDate                     DateTime?                     @db.Date
  outstandingInPaise          Int
  gstComponentInPaise         Int                           @default(0)
  tdsInPaise                  Int                           @default(0)
  currency                    String                        @default("INR")
  reference                   String?
  source                      String?
  reviewStatus                AccountingOpeningReviewStatus @default(PENDING)
  remainingOutstandingInPaise Int?
  sortOrder                   Int                           @default(0)
  createdAt                   DateTime                      @default(now())

  @@unique([batchId, vendorName, billNumber])
  @@index([batchId])
}

model AccountingOpeningArLine {
  id                 String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId            String                        @db.Uuid
  batch              AccountingOpeningBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  customerName       String
  customerId         String?                       @db.Uuid
  invoiceReference   String
  invoiceDate        DateTime?                     @db.Date
  dueDate            DateTime?                     @db.Date
  outstandingInPaise Int
  currency           String                        @default("INR")
  source             String?
  reviewStatus       AccountingOpeningReviewStatus @default(PENDING)
  sortOrder          Int                           @default(0)
  createdAt          DateTime                      @default(now())

  @@unique([batchId, invoiceReference])
  @@index([batchId])
}

model AccountingOpeningGstLine {
  id             String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId        String                        @db.Uuid
  batch          AccountingOpeningBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  accountCode    String
  /// Signed net: positive = debit (asset/input), negative = credit (liability/output)
  balanceInPaise Int
  source         String?
  reviewStatus   AccountingOpeningReviewStatus @default(PENDING)
  sortOrder      Int                           @default(0)
  createdAt      DateTime                      @default(now())

  @@unique([batchId, accountCode])
  @@index([batchId])
}

model AccountingOpeningEquityLine {
  id            String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId       String                        @db.Uuid
  batch         AccountingOpeningBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  accountCode   String
  /// Credit positive for capital/RE/OBE credit balances
  amountInPaise Int
  reason        String?
  reviewStatus  AccountingOpeningReviewStatus @default(PENDING)
  sortOrder     Int                           @default(0)
  createdAt     DateTime                      @default(now())

  @@unique([batchId, accountCode])
  @@index([batchId])
}
