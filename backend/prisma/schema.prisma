// ─── Native accounting (isolated from commerce tables) ───────────────────────

enum AccountingAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountingJournalStatus {
  DRAFT
  POSTED
  VOID
}

enum AccountingPostingEventStatus {
  PENDING
  RETRYING
  POSTED
  FAILED
  SKIPPED
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

enum AccountingGatewaySettlementStatus {
  IMPORTED
  PREVIEWED
  POSTED
  MISMATCH
  SKIPPED
  FAILED
}

enum AccountingGatewaySettlementLineType {
  PAYMENT
  REFUND
  TRANSFER
  ADJUSTMENT
  UNKNOWN
}

enum AccountingGatewaySettlementLineMappingStatus {
  MAPPED
  UNMAPPED
  DATA_GAP
  UNMAPPED_PAYMENT
  UNMAPPED_REFUND
  UNKNOWN_ADJUSTMENT
}

model AccountingAccount {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String                  @unique
  name          String
  type          AccountingAccountType
  parentId      String?                 @db.Uuid
  parent        AccountingAccount?      @relation("AccountingAccountTree", fields: [parentId], references: [id])
  children      AccountingAccount[]     @relation("AccountingAccountTree")
  currency      String                  @default("INR")
  isActive      Boolean                 @default(true)
  isSystem      Boolean                 @default(false)
  zohoAccountId String?
  description   String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  journalLines  AccountingJournalLine[]

  @@index([type])
  @@index([isActive])
  @@index([parentId])
}

model AccountingJournalEntry {
  id                     String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryNumber            String                           @unique
  entryDate              DateTime                         @db.Date
  memo                   String?
  status                 AccountingJournalStatus          @default(DRAFT)
  postedAt               DateTime?
  postedByUserId         String?                          @db.Uuid
  totalDebitInPaise      Int                              @default(0)
  totalCreditInPaise     Int                              @default(0)
  currency               String                           @default("INR")
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  lines                  AccountingJournalLine[]
  documentLinks          AccountingDocumentLink[]
  postingEvent           AccountingPostingEvent?
  gatewaySettlement      AccountingGatewaySettlement?
  vendorPayment          AccountingVendorPayment?
  inventoryOpeningBatch  AccountingInventoryOpeningBatch?
  productionOpeningBatch AccountingOpeningBatch?
  bankTransfer           AccountingBankTransfer?
  bankStatementMatches   AccountingBankStatementMatch[]

  @@index([entryDate])
  @@index([status])
  @@index([postedAt])
}

model AccountingJournalLine {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalEntryId String                  @db.Uuid
  journalEntry   AccountingJournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String                  @db.Uuid
  account        AccountingAccount       @relation(fields: [accountId], references: [id])
  debitInPaise   Int                     @default(0)
  creditInPaise  Int                     @default(0)
  lineMemo       String?
  sortOrder      Int                     @default(0)
  documentLinkId String?                 @db.Uuid
  documentLink   AccountingDocumentLink? @relation(fields: [documentLinkId], references: [id])
  createdAt      DateTime                @default(now())

  @@index([journalEntryId])
  @@index([accountId])
}

model AccountingPostingEvent {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType         String
  sourceType        String
  sourceId          String
  uniqueKey         String
  payloadJson       Json?
  status            AccountingPostingEventStatus @default(PENDING)
  attemptCount      Int                          @default(0)
  lastError         String?
  processedAt       DateTime?
  journalEntryId    String?                      @unique @db.Uuid
  journalEntry      AccountingJournalEntry?      @relation(fields: [journalEntryId], references: [id])
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  gatewaySettlement AccountingGatewaySettlement?
  vendorPayment     AccountingVendorPayment?
  bankTransfer      AccountingBankTransfer?

  @@unique([eventType, uniqueKey])
  @@index([status])
  @@index([createdAt])
  @@index([sourceType, sourceId])
}

model AccountingDocumentLink {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentType     String
  documentId       String
  journalEntryId   String                  @db.Uuid
  journalEntry     AccountingJournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  zohoDocumentId   String?
  zohoDocumentType String?
  journalLines     AccountingJournalLine[]

  @@unique([documentType, documentId, journalEntryId])
  @@index([documentType, documentId])
}

model AccountingPeriod {
  id        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  startDate DateTime               @db.Date
  endDate   DateTime               @db.Date
  status    AccountingPeriodStatus @default(OPEN)
  closedAt  DateTime?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([startDate, endDate])
  @@index([status])
}

model AccountingSequence {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequenceType String
  prefix       String   @default("")
  yearMonth    String
  lastSeq      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sequenceType, yearMonth])
}

model AccountingAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Razorpay (etc.) settlement batch — accounting-owned; not commerce Payment.settlement* authority.
model AccountingGatewaySettlement {
  id                   String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider             PaymentProvider
  providerSettlementId String
  currency             String                            @default("INR")
  settledAt            DateTime
  utr                  String?
  targetBankAccountId  String?                           @db.Uuid
  targetBankAccount    AccountingBankAccount?            @relation("SettlementTargetBank", fields: [targetBankAccountId], references: [id])
  grossInPaise         Int                               @default(0)
  feeInPaise           Int                               @default(0)
  taxInPaise           Int                               @default(0)
  netInPaise           Int                               @default(0)
  status               AccountingGatewaySettlementStatus @default(IMPORTED)
  gstItcStatus         String                            @default("UNVERIFIED_PENDING_TAX_INVOICE")
  sourcePayloadHash    String
  rawPayload           Json?
  postingEventId       String?                           @unique @db.Uuid
  postingEvent         AccountingPostingEvent?           @relation(fields: [postingEventId], references: [id])
  journalEntryId       String?                           @unique @db.Uuid
  journalEntry         AccountingJournalEntry?           @relation(fields: [journalEntryId], references: [id])
  lastError            String?
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt
  lines                AccountingGatewaySettlementLine[]

  @@unique([provider, providerSettlementId])
  @@index([settledAt])
  @@index([status])
  @@index([utr])
}

model AccountingGatewaySettlementLine {
  id                String                                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlementId      String                                       @db.Uuid
  settlement        AccountingGatewaySettlement                  @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  lineType          AccountingGatewaySettlementLineType
  providerEntityId  String
  amountInPaise     Int                                          @default(0)
  feeInPaise        Int                                          @default(0)
  taxInPaise        Int                                          @default(0)
  debitInPaise      Int                                          @default(0)
  creditInPaise     Int                                          @default(0)
  providerPaymentId String?
  providerRefundId  String?
  paymentId         String?                                      @db.Uuid
  orderId           String?                                      @db.Uuid
  mappingStatus     AccountingGatewaySettlementLineMappingStatus @default(UNMAPPED)
  rawPayload        Json?
  sortOrder         Int                                          @default(0)
  createdAt         DateTime                                     @default(now())

  @@unique([settlementId, providerEntityId])
  @@index([settlementId])
  @@index([providerPaymentId])
  @@index([providerRefundId])
  @@index([paymentId])
  @@index([orderId])
  @@index([mappingStatus])
}

enum AccountingVendorPaymentMethod {
  BANK_TRANSFER
  UPI
  CHEQUE
  CASH
}

enum AccountingVendorPaymentStatus {
  DRAFT
  POSTED
  VOID
}

/// Accounting-owned supplier payment — not derived from VendorBill.paidInPaise.
model AccountingVendorPayment {
  id                String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentNumber     String                              @unique
  vendorId          String                              @db.Uuid
  vendor            Vendor                              @relation(fields: [vendorId], references: [id])
  paymentDate       DateTime                            @db.Date
  amountInPaise     Int
  currency          String                              @default("INR")
  paymentMethod     AccountingVendorPaymentMethod
  paidAccountCode   String
  bankAccountId     String?                             @db.Uuid
  bankAccount       AccountingBankAccount?              @relation(fields: [bankAccountId], references: [id])
  utr               String?
  notes             String?
  status            AccountingVendorPaymentStatus       @default(DRAFT)
  sourcePayloadHash String
  postingEventId    String?                             @unique @db.Uuid
  postingEvent      AccountingPostingEvent?             @relation(fields: [postingEventId], references: [id])
  journalEntryId    String?                             @unique @db.Uuid
  journalEntry      AccountingJournalEntry?             @relation(fields: [journalEntryId], references: [id])
  createdByUserId   String?                             @db.Uuid
  lastError         String?
