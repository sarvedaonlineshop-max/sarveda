enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model OtpCode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target    String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

enum EnquirySource {
  CONTACT
  CORPORATE
  COURSE
  EVENT
  INSIGHTS
}

enum EnquirySubjectCategory {
  ORDER
  PAYMENT
  COURSE
  CORPORATE
  OTHER
}

enum EnquiryMessageAuthor {
  CUSTOMER
  ADMIN
}

enum EnquiryThreadStatus {
  OPEN
  CLOSED
}

model EnquiryThread {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source          EnquirySource
  subjectCategory EnquirySubjectCategory?
  customSubject   String?
  customerName    String
  customerEmail   String
  customerPhone   String?
  orderNumber     String?
  contextTitle    String?
  contextUrl      String?
  userId          String?                 @db.Uuid
  status          EnquiryThreadStatus     @default(OPEN)
  unreadByAdmin   Boolean                 @default(true)
  lastMessageAt   DateTime                @default(now())
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  user            User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages        EnquiryMessage[]

  @@index([unreadByAdmin, lastMessageAt(sort: Desc)])
  @@index([customerEmail])
  @@index([source])
}

model EnquiryMessage {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId    String               @db.Uuid
  authorType  EnquiryMessageAuthor
  adminUserId String?              @db.Uuid
  authorName  String
  authorEmail String
  body        String
  createdAt   DateTime             @default(now())
  thread      EnquiryThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  adminUser   User?                @relation("EnquiryAdminMessages", fields: [adminUserId], references: [id], onDelete: SetNull)
  attachments EnquiryAttachment[]

  @@index([threadId, createdAt])
}

model EnquiryAttachment {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId     String         @db.Uuid
  fileName      String
  mimeType      String
  fileSizeBytes Int?
  s3Key         String
  s3Url         String
  createdAt     DateTime       @default(now())
  message       EnquiryMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REOPENED
}

enum ComplaintEventType {
  COMMENT
  STATUS_CHANGE
  REOPENED
  ATTACHMENT_ADDED
  CREATED
}

enum ComplaintAuthorType {
  MEMBER
  ADMIN
}

enum AssigneeResponseStatus {
  PENDING
  ACCEPTED
  DENIED_AWAITING_OWNER
}

enum ComplaintAppRole {
  ADMIN
  STAFF
}

model Complaint {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId        String?               @db.Uuid
  raisedByEmail   String
  raisedByName    String?
  assignedByEmail String?
  assignedByName  String?
  dueDate         DateTime?
  pendingDeadlineDate         DateTime?
  pendingDeadlineRequestedBy  String?
  title           String
  description     String?
  priority        ComplaintPriority     @default(MEDIUM)
  status          ComplaintStatus       @default(OPEN)
  isPrivate       Boolean               @default(false)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  resolvedAt      DateTime?
  parent          Complaint?            @relation("ComplaintHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        Complaint[]           @relation("ComplaintHierarchy")
  events          ComplaintEvent[]
  attachments     ComplaintAttachment[]
  assignees       TaskAssignee[]

  @@index([status])
  @@index([raisedByEmail])
  @@index([assignedByEmail])
  @@index([priority])
  @@index([parentId])
  @@index([isPrivate])
}

model TaskAssignee {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId         String                  @db.Uuid
  assigneeEmail  String
  assigneeName   String?
  responseStatus AssigneeResponseStatus  @default(PENDING)
  markedClosedAt DateTime?
  assignedAt     DateTime                @default(now())
  task           Complaint               @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, assigneeEmail])
  @@index([assigneeEmail])
}

model TaskNotification {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientEmail String
  taskId         String   @db.Uuid
  taskTitle      String
  type           String
  message        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([recipientEmail, isRead])
  @@index([taskId])
}

model ComplaintEvent {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintId String                @db.Uuid
  type        ComplaintEventType
  authorEmail String
  authorType  ComplaintAuthorType
  message     String?
  deletedAt   DateTime?
  createdAt   DateTime              @default(now())
  complaint   Complaint             @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  attachments ComplaintAttachment[]

  @@index([complaintId])
}

model ComplaintAttachment {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintId   String?         @db.Uuid
  eventId       String?         @db.Uuid
  type          String
  s3Key         String
  s3Url         String
  fileName      String?
  fileSizeBytes Int?
  createdAt     DateTime        @default(now())
  complaint     Complaint?      @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  event         ComplaintEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([eventId])
}

model ComplaintWhitelist {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String           @unique
  name         String?
  avatarUrl    String?
  avatarS3Key  String?
  role         ComplaintAppRole @default(ADMIN)
  passwordHash String?
  addedAt      DateTime         @default(now())
  isActive     Boolean          @default(true)
}

model AppVersion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform     String   @default("android")
  version      String
  versionCode  Int
  apkUrl       String
  mandatory    Boolean  @default(false)
  releaseNotes String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([platform, isActive])
}
