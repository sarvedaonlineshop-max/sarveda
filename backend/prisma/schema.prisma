  /// Reverse-shipping deduction is stored separately and is always 0 in Phase 1A.
  forwardShippingPaise         Int       @default(0)
  reverseShippingDeductedPaise Int       @default(0)
  otherDeductionPaise          Int       @default(0)
  otherDeductionLabel          String?
  approvedRefundPaise          Int
  createdAt                    DateTime  @default(now())
  refund                       Refund    @relation(fields: [refundId], references: [id])
  orderItem                    OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([refundId, orderItemId])
  @@index([orderItemId])
}

