/// Immutable per-line refund breakdown. Written with the Refund row, never updated.
/// Historical refunds without reliable line data remain unallocated (no backfill).
model RefundAllocation {
  id                           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  refundId                     String    @db.Uuid
  orderItemId                  String    @db.Uuid
