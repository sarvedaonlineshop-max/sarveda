# Copy this file to .env.local and fill values. Next reads .env.local (not .env.example).

# REQUIRED for /admin middleware: must match backend/.env JWT_SECRET exactly.
JWT_SECRET=

# Local dev: Express URL for server-side RSC fetches (browser still uses same-origin /api).
NEXT_PUBLIC_API_URL=http://localhost:5000
# Optional; defaults to NEXT_PUBLIC_API_URL. Used for RSC/build fetches from Node in development.
# INTERNAL_API_URL=http://localhost:5000
# Production on Vercel: public site URL so server components call https://yoursite.com/api (rewrites → EC2). Vercel sets VERCEL_URL if unset.
# NEXT_PUBLIC_SITE_URL=https://sarveda.com
# Staging demo: NEXT_PUBLIC_SITE_URL=https://sarveda-demo.xyz
