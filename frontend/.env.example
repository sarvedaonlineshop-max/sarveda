# Copy this file to .env.local and fill values. Next reads .env.local (not .env.example).

# Optional. /admin uses same-origin /api/auth/me (DB role). Keep in sync with backend if you add edge JWT checks later.
# JWT_SECRET=

# Local dev: Express URL for server-side RSC fetches (browser still uses same-origin /api).
NEXT_PUBLIC_API_URL=http://localhost:5000
# Optional; defaults to NEXT_PUBLIC_API_URL. Used for RSC/build fetches from Node in development.
# INTERNAL_API_URL=http://localhost:5000
# Production on Vercel: public site URL so server components call https://yoursite.com/api (rewrites → EC2). Vercel sets VERCEL_URL if unset.
# NEXT_PUBLIC_SITE_URL=https://sarveda.com
# Staging demo: NEXT_PUBLIC_SITE_URL=https://sarveda-demo.xyz
# India-only storefront (hides country selector; pair with backend INDIA_CHECKOUT_ONLY=1).
# NEXT_PUBLIC_INDIA_CHECKOUT_ONLY=1

# Customer WhatsApp (wa.me links) — keep identical to backend EXOTEL_WHATSAPP_FROM
NEXT_PUBLIC_WHATSAPP_NUMBER=+919611361100
NEXT_PUBLIC_ENQUIRY_EMAIL=care@sarveda.com

# Analytics (production only — set in Vercel for sarveda.com)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXXX

# Free shipping progress bar threshold (INR paise, default 99900 = ₹999)
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_PAISE=99900

# Default HSN for admin product form placeholder (musical instruments / wellness)
NEXT_PUBLIC_DEFAULT_HSN_CODE=9205

# Purchases module preview (vendors, PO, bills, expenses) — requires backend PURCHASES_MODULE_ENABLED=1
# NEXT_PUBLIC_PURCHASES_ENABLED=1

# Native accounting admin UI — requires backend NATIVE_ACCOUNTING_ENABLED=1 for data APIs
# NEXT_PUBLIC_ACCOUNTING_ENABLED=1
# UAT banner on accounting pages (default on when accounting UI enabled; set 0 after Phase 7D go-live)
# NEXT_PUBLIC_ACCOUNTING_UAT_MODE=1

# Google Sign-In (storefront + /test-complaint) — must match backend GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
