# Copy this file to .env.local and fill values. Next reads .env.local (not .env.example).

# REQUIRED for /admin middleware: must match backend/.env JWT_SECRET exactly.
JWT_SECRET=

# Where Next.js proxies /api/* (server-side + rewrites). Usually same as your Express URL.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Optional; defaults to NEXT_PUBLIC_API_URL. Used for RSC/build fetches from Node.
# INTERNAL_API_URL=http://localhost:5000
